<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <artifactId>r-uu.app.java.pragma.bom</artifactId>
  <version>0.0.1</version>
  <packaging>pom</packaging>
  <name>${project.artifactId}</name>
  <description>bill of material for pragma application: pins the lib-java version and manages app module versions</description>

  <parent>
    <groupId>r-uu</groupId>
    <artifactId>r-uu.lib.java.bom</artifactId>
    <version>0.0.1</version>
    <!-- inherited: build/plugin/property config, repositories and external dependencyManagement -->
    <relativePath>../../../lib/bom/pom.xml</relativePath>
  </parent>

  <dependencyManagement>
    <dependencies>
      <!--
        Decouple the app version from the lib-java version (variant B).

        The lib-java BOM is our parent, so its dependencyManagement is INHERITED. There it
        declares every r-uu.lib.java.* module with <version>${project.version}</version>, which
        - when inherited - resolves against THIS project's version, i.e. the app version. That
        would silently tie the app version to the lib version.

        A <scope>import</scope> of the lib BOM does NOT fix this: imported BOMs have the lowest
        precedence in Maven and are overridden by inherited/directly-declared management. The
        only mechanism that overrides an inherited entry is a DIRECTLY declared one. Therefore
        each lib-java module actually used by this app is pinned here to the lib version in plain
        text (no property, per project convention).

        IMPORTANT: when a module starts depending on a new r-uu.lib.java.* artifact, add a pin
        here. Without a pin it falls back to the inherited app version; once app and lib versions
        differ that produces a build error (missing artifact at the app version).
      -->
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.lib.java.cdi.common</artifactId>
        <version>0.0.1</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.lib.java.cdi.se</artifactId>
        <version>0.0.1</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.lib.java.fx.comp</artifactId>
        <version>0.0.1</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.lib.java.fx.core</artifactId>
        <version>0.0.1</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.lib.java.jpa.core</artifactId>
        <version>0.0.1</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.lib.java.junit</artifactId>
        <version>0.0.1</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.lib.java.postgres.ui</artifactId>
        <version>0.0.1</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.lib.java.util</artifactId>
        <version>0.0.1</version>
      </dependency>

      <!-- App modules, sorted alphabetically by artifactId -->
      <!-- these DO follow the app version on purpose (${project.version}) -->
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.app.java.pragma.bean</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.app.java.pragma.core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.app.java.pragma.dto</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.app.java.pragma.fx</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.app.java.pragma.jpa</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.app.java.pragma.rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>r-uu</groupId>
        <artifactId>r-uu.app.java.pragma.rest-client</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>
