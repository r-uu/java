<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:weld="http://jboss.org/schema/weld/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd
                           http://jboss.org/schema/weld/beans http://jboss.org/schema/weld/beans_1_1.xsd"
       version="4.0"
       bean-discovery-mode="annotated">
  <!--
    Im Fat-JAR scannt Weld sonst alle Klassen aller enthaltenen Bibliotheken und scheitert,
    wenn diese optionale Abhängigkeiten referenzieren (OSGi, Disruptor, …).
    Der Include-Filter beschränkt die Bean-Discovery auf eigene Klassen.
  -->
  <weld:scan>
    <weld:include name="de.ruu.**"/>
  </weld:scan>
</beans>
