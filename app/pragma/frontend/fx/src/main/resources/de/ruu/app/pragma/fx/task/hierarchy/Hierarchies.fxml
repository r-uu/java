<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Top bar: group selection + manage button -->
        <HBox alignment="CENTER_LEFT" spacing="5">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
            <Label text="group"/>
            <HBox fx:id="cbGroupsContainer" minWidth="200"/>
            <Button fx:id="btnManageGroups" mnemonicParsing="false"
                    prefHeight="20" prefWidth="20">
                <graphic><FontIcon iconLiteral="far-folder" iconSize="11"/></graphic>
                <tooltip><Tooltip text="task groups verwalten"/></tooltip>
            </Button>
            <Button fx:id="btnReload" mnemonicParsing="false"
                    prefHeight="20" prefWidth="20">
                <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="11"/></graphic>
                <tooltip><Tooltip text="neu laden"/></tooltip>
            </Button>
            <Label fx:id="lblStatus" style="-fx-font-size: 11px; -fx-text-fill: #cc3333;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Three panel containers — filled programmatically by the controller -->
        <SplitPane dividerPositions="0.33, 0.66" VBox.vgrow="ALWAYS"
                   maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
            <AnchorPane fx:id="panePred"   minWidth="200"
                        maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"/>
            <AnchorPane fx:id="paneCenter" minWidth="200"
                        maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"/>
            <AnchorPane fx:id="paneSucc"   minWidth="200"
                        maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"/>
        </SplitPane>

    </VBox>
</AnchorPane>
