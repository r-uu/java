              </children>
            </HBox>
          </top>
          <center>
            <TableView fx:id="tblHistory">
              <columns>
                <TableColumn fx:id="colHistoryChangedAt" text="changedAt" prefWidth="180"/>
                <TableColumn fx:id="colHistoryEntityType" text="entityType" prefWidth="120"/>
                <TableColumn fx:id="colHistoryEntityId" text="entityId" prefWidth="90"/>
                <TableColumn fx:id="colHistoryField" text="field" prefWidth="160"/>
                <TableColumn fx:id="colHistoryOld" text="oldValue" prefWidth="220"/>
                <TableColumn fx:id="colHistoryNew" text="newValue" prefWidth="220"/>
                <TableColumn fx:id="colHistoryCategory" text="category" prefWidth="130"/>
              </columns>
            </TableView>
          </center>
        </BorderPane>
      </Tab>

      <Tab text="Analytics">
        <BorderPane>
          <top>
            <HBox spacing="6">
              <children>
                <Button fx:id="btnAnalyticsRefresh" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="reload analytics"/></tooltip>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblAnalyticsStatus"/>
              </children>
            </HBox>
          </top>
          <center>
            <SplitPane orientation="VERTICAL" dividerPositions="0.5">
              <items>
                <VBox spacing="4">
                  <children>
                    <Label text="Überauslastungen"/>
                    <TableView fx:id="tblWorkload">
                      <columns>
                        <TableColumn fx:id="colWorkloadUser" text="user" prefWidth="220"/>
                        <TableColumn fx:id="colWorkloadCapacity" text="capacity" prefWidth="120"/>
                        <TableColumn fx:id="colWorkloadAssigned" text="assigned" prefWidth="120"/>
                        <TableColumn fx:id="colWorkloadOverbooked" text="overbooked" prefWidth="140"/>
                      </columns>
                    </TableView>
                  </children>
                </VBox>
                <VBox spacing="4">
                  <children>
                    <Label text="Zeitüberschreitungen"/>
                    <TableView fx:id="tblOverruns">
                      <columns>
                        <TableColumn fx:id="colOverrunTask" text="task" prefWidth="260"/>
                        <TableColumn fx:id="colOverrunEstimate" text="estimate" prefWidth="120"/>
                        <TableColumn fx:id="colOverrunActual" text="actual" prefWidth="120"/>
                        <TableColumn fx:id="colOverrunDelta" text="overrun" prefWidth="140"/>
                      </columns>
                    </TableView>
                  </children>
                </VBox>
              </items>
            </SplitPane>
          </center>
        </BorderPane>
      </Tab>
    </tabs>
  </TabPane>
</AnchorPane>
