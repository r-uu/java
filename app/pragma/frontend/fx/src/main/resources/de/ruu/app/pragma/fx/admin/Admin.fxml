                </Button>
                <Button fx:id="btnAvailabilityDelete" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="far-trash-alt" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="delete availability"/></tooltip>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblAvailabilityStatus"/>
              </children>
            </HBox>
          </top>
          <center>
            <TableView fx:id="tblAvailabilities">
              <columns>
                <TableColumn fx:id="colAvailabilityId" text="id" prefWidth="70"/>
                <TableColumn fx:id="colAvailabilityUser" text="userId" prefWidth="120"/>
                <TableColumn fx:id="colAvailabilityFrom" text="from" prefWidth="140"/>
                <TableColumn fx:id="colAvailabilityTo" text="to" prefWidth="140"/>
                <TableColumn fx:id="colAvailabilityCapacity" text="capacity h/day" prefWidth="130"/>
                <TableColumn fx:id="colAvailabilityType" text="type" prefWidth="130"/>
                <TableColumn fx:id="colAvailabilityNote" text="note" prefWidth="260"/>
              </columns>
            </TableView>
          </center>
        </BorderPane>
      </Tab>

      <Tab text="History">
        <BorderPane>
          <top>
            <HBox spacing="6">
              <children>
                <Button fx:id="btnHistoryRefresh" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="reload history"/></tooltip>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
