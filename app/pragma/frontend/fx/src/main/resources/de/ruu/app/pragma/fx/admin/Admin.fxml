<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
  <TabPane tabClosingPolicy="UNAVAILABLE" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
    <tabs>
      <Tab text="Users">
        <BorderPane>
          <top>
            <HBox spacing="6">
              <children>
                <Button fx:id="btnUsersRefresh" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="reload users"/></tooltip>
                </Button>
                <Button fx:id="btnUsersAdd" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="far-plus-square" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="add user"/></tooltip>
                </Button>
                <Button fx:id="btnUsersEdit" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="far-edit" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="edit user"/></tooltip>
                </Button>
                <Button fx:id="btnUsersDelete" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="far-trash-alt" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="delete user"/></tooltip>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblUsersStatus"/>
              </children>
            </HBox>
          </top>
          <center>
            <TableView fx:id="tblUsers">
              <columns>
                <TableColumn fx:id="colUserId" text="id" prefWidth="70"/>
                <TableColumn fx:id="colUserUsername" text="username" prefWidth="180"/>
                <TableColumn fx:id="colUserKeycloakId" text="keycloakUserId" prefWidth="190"/>
                <TableColumn fx:id="colUserDisplayName" text="displayName" prefWidth="220"/>
                <TableColumn fx:id="colUserEmail" text="email" prefWidth="240"/>
                <TableColumn fx:id="colUserActive" text="active" prefWidth="80"/>
              </columns>
            </TableView>
          </center>
        </BorderPane>
      </Tab>

      <Tab text="Groups">
        <BorderPane>
          <top>
            <HBox spacing="6">
              <children>
                <Button fx:id="btnGroupsRefresh" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="reload groups"/></tooltip>
                </Button>
                <Button fx:id="btnGroupsAdd" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="far-plus-square" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="add group"/></tooltip>
                </Button>
                <Button fx:id="btnGroupsEdit" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="far-edit" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="edit group"/></tooltip>
                </Button>
                <Button fx:id="btnGroupsDelete" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="far-trash-alt" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="delete group"/></tooltip>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblGroupsStatus"/>
              </children>
            </HBox>
          </top>
          <center>
            <TableView fx:id="tblGroups">
              <columns>
                <TableColumn fx:id="colGroupId" text="id" prefWidth="70"/>
                <TableColumn fx:id="colGroupName" text="name" prefWidth="220"/>
                <TableColumn fx:id="colGroupDescription" text="description" prefWidth="350"/>
                <TableColumn fx:id="colGroupActive" text="active" prefWidth="80"/>
              </columns>
            </TableView>
          </center>
        </BorderPane>
      </Tab>

      <Tab text="Memberships">
        <BorderPane>
          <top>
            <HBox spacing="6">
              <children>
                <Button fx:id="btnMembershipsRefresh" mnemonicParsing="false" prefHeight="20" prefWidth="20">
