                <TableColumn fx:id="colAssignmentTask" text="taskId" prefWidth="110"/>
                <TableColumn fx:id="colAssignmentType" text="type" prefWidth="140"/>
                <TableColumn fx:id="colAssignmentTargetType" text="targetType" prefWidth="120"/>
                <TableColumn fx:id="colAssignmentTargetId" text="targetId" prefWidth="110"/>
                <TableColumn fx:id="colAssignmentShare" text="share" prefWidth="90"/>
                <TableColumn fx:id="colAssignmentPriority" text="priority" prefWidth="90"/>
                <TableColumn fx:id="colAssignmentActive" text="active" prefWidth="90"/>
              </columns>
            </TableView>
          </center>
        </BorderPane>
      </Tab>

      <Tab text="Availability">
        <BorderPane>
          <top>
            <HBox spacing="6">
              <children>
                <Button fx:id="btnAvailabilityRefresh" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="11"/></graphic>
