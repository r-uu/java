                <TableColumn fx:id="colMembershipUser" text="userId" prefWidth="120"/>
                <TableColumn fx:id="colMembershipGroup" text="groupId" prefWidth="120"/>
                <TableColumn fx:id="colMembershipRole" text="role" prefWidth="170"/>
                <TableColumn fx:id="colMembershipValidFrom" text="validFrom" prefWidth="140"/>
                <TableColumn fx:id="colMembershipValidTo" text="validTo" prefWidth="140"/>
                <TableColumn fx:id="colMembershipActive" text="active" prefWidth="90"/>
              </columns>
            </TableView>
          </center>
        </BorderPane>
      </Tab>

      <Tab text="Assignments">
        <BorderPane>
          <top>
            <HBox spacing="6">
              <children>
                <Button fx:id="btnAssignmentsRefresh" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="reload assignments"/></tooltip>
                </Button>
                <Button fx:id="btnAssignmentsAdd" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="far-plus-square" iconSize="11"/></graphic>
