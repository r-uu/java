                </Button>
                <Button fx:id="btnAssignmentsEdit" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="far-edit" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="edit assignment"/></tooltip>
                </Button>
                <Button fx:id="btnAssignmentsDelete" mnemonicParsing="false" prefHeight="20" prefWidth="20">
                  <graphic><FontIcon iconLiteral="far-trash-alt" iconSize="11"/></graphic>
                  <tooltip><Tooltip text="delete assignment"/></tooltip>
                </Button>
