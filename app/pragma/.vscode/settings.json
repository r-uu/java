{
  "java.configuration.updateBuildConfiguration": "automatic",

  // Disable auto-build to prevent JDT from overwriting Maven-compiled .class files
  "java.autobuild.enabled": false,

  "java.import.maven.enabled": true,
  "maven.pomfile.globPattern": "**/pom.xml",
  "java.project.sourcePaths": [],
  "java.project.referencedLibraries": [],

  "java.errors.incompleteClasspath.severity": "ignore",

  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m",
  "java.debug.settings.onBuildFailureProceed": true,

  "maven.view": "hierarchical",

  // Windsurf / VS Code: inline AI-Vorschläge unterdrücken
  "editor.inlineSuggest.enabled": false,
  "editor.quickSuggestions": {
    "other": "off",
    "comments": "off",
    "strings": "off"
  },

  // Markdown-Preview aktivieren
  "markdown.preview.breaks": true,
  "markdown.preview.doubleClickToSwitchToEditor": true,
  "[markdown]": {
    "editor.defaultFormatter": "vscode.markdown-language-features",
    "editor.wordWrap": "on"
  }
}
