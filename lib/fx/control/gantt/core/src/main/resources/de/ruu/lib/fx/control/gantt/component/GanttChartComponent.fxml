<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.SplitPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.canvas.Canvas?>

<AnchorPane fx:id="root" 
            xmlns="http://javafx.com/javafx/20" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.ruu.lib.fx.control.gantt.component.GanttChartController">

    <SplitPane dividerPositions="0.2" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Left: Task Hierarchy -->
        <AnchorPane fx:id="treePane">
            <TreeView fx:id="treeView" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
                      AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>
        </AnchorPane>

        <!-- Right: Gantt Chart Canvas -->
        <AnchorPane fx:id="canvasPane">
            <Canvas fx:id="canvas" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
                    AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>
        </AnchorPane>

    </SplitPane>

</AnchorPane>
